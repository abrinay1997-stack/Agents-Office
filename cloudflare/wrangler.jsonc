{
  // Agents Office en Cloudflare. Un Worker sirve la página (Static Assets) y la API en el MISMO origen,
  // igual que CALENDARIOS-MARKETING-APP. Los secretos NO van aquí: el workflow los sube con `wrangler secret bulk`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agents-office",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public/",
    "html_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },

  // El database_id lo rellena el workflow «Cloudflare · preparar» (crea la base en la cuenta nueva). No es un secreto.
  "d1_databases": [
    { "binding": "DB", "database_name": "agents-office-db", "database_id": "REEMPLAZAR_CON_EL_ID_DE_D1", "migrations_dir": "migraciones" }
  ],

  // Fase 10: presencia y cambios en vivo. Un Durable Object (clase Hub, reexportada desde el módulo main) con almacenamiento SQLite
  // (`new_sqlite_classes`: entra en el plan gratuito; con `new_classes` el despliegue pide plan de pago).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1-hub", "new_sqlite_classes": ["Hub"] }],

  // CON-01: convertir PNG/WebP a JPEG para Instagram (conductores.js → aJpegDeEnv). Cloudflare Images (binding de transformación): sin él Instagram falla con un mensaje claro.
  "images": { "binding": "IMAGES" },

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "agents-office-contenido" }],

  "vars": { "AI_MODELO": "claude-sonnet-5-5", "CONTENIDO_MAX_LLAMADAS": "40", "CONTENIDO_MAX_CONSULTAS": "40", "CONTENIDO_MAX_ACCIONES": "6", "AGENTES_MAX_LLAMADAS": "60", "AGENTES_MAX_CONSULTAS": "300" },

  "triggers": { "crons": ["* * * * *"] },
  // P1 del plan docs/plan-mcp-oficina-panaclaw.md: dominio propio. workers_dev DEBE seguir en true (con `routes`, wrangler lo daría por false y rompería las vueltas de OAuth/webhooks de workers.dev).
  // Permisos del token de despliegue (docs de Cloudflare: Workers authorization, https://developers.cloudflare.com/workers/authorization/): «Account → Workers Scripts → Edit» y «Zone → Workers Routes → Edit» sobre panaclaw.com.
  // NO confirmado en la documentación oficial: si además hace falta «Zone → Zone → Read» o «DNS → Edit» para un custom_domain; la doc de `zone_name` solo dice que con token exige alcance de cuenta. Se probará en el primer despliegue.
  "routes": [{ "pattern": "oficina.panaclaw.com", "custom_domain": true }],
  "workers_dev": true,
  // Los registros de invocación (con la URL de cada petición) se apagan: un enlace de invitación es una URL con un testigo dentro. Los console.error del código siguen.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
