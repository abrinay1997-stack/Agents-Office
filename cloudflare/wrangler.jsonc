{
  // Agents Office en Cloudflare. Un Worker sirve la página (Static Assets) y la API en el MISMO origen,
  // igual que CALENDARIOS-MARKETING-APP. Los secretos NO van aquí: el workflow los sube con `wrangler secret bulk`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agents-office",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public/",
    "html_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },

  // El database_id lo rellena el workflow «Cloudflare · preparar» (crea la base en la cuenta nueva). No es un secreto.
  "d1_databases": [
    { "binding": "DB", "database_name": "agents-office-db", "database_id": "REEMPLAZAR_CON_EL_ID_DE_D1", "migrations_dir": "migraciones" }
  ],

  // Fase 10: presencia y cambios en vivo. Un Durable Object (clase Hub, reexportada desde el módulo main) con almacenamiento SQLite
  // (`new_sqlite_classes`: entra en el plan gratuito; con `new_classes` el despliegue pide plan de pago).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1-hub", "new_sqlite_classes": ["Hub"] }],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "agents-office-contenido" }],

  "vars": { "AI_MODELO": "claude-sonnet-5-5", "CONTENIDO_MAX_LLAMADAS": "40", "CONTENIDO_MAX_CONSULTAS": "40", "CONTENIDO_MAX_ACCIONES": "6", "AGENTES_MAX_LLAMADAS": "60", "AGENTES_MAX_CONSULTAS": "300" },

  "triggers": { "crons": ["* * * * *"] },
  "workers_dev": true,
  "observability": { "enabled": true }
}
