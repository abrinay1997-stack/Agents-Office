{
  "name": "agents-office",
  "version": "3.2.1-beta.2",
  "description": "Agents Office v3 (Beta) — a 3D isometric office where AI agents do real work on your own Claude login",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node serve.mjs",
    "build": "node build.mjs",
    "check": "node check.mjs",
    "check:live": "CHECK_LIVE=1 node check.mjs",
    "test": "node --test --test-concurrency=4",
    "secrets": "node scripts/secrets-scan.mjs --all",
    "prepare": "node scripts/install-hooks.mjs",
    "graph": "node graph-build.mjs",
    "lint": "oxlint .",
    "tipos": "tsc -p tsconfig.json",
    "topes": "node scripts/topes-codigo-nuevo.mjs",
    "audit:info": "npm audit --omit=dev --audit-level=high || true"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.64.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
